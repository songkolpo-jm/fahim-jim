<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Private Space</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Sacramento&display=swap');
    
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      user-select: none;
      -webkit-user-select: none;
      background-color: #030712;
    }
    
    .font-handwriting {
      font-family: 'Sacramento', cursive;
    }
    
    .theme-love { --accent: #ff2a6d; --accent-glow: rgba(255, 42, 109, 0.4); }
    .theme-messenger { --accent: #0084ff; --accent-glow: rgba(0, 132, 255, 0.4); }
    .theme-dark { --accent: #6366f1; --accent-glow: rgba(99, 102, 241, 0.4); }
    .theme-emerald { --accent: #10b981; --accent-glow: rgba(16, 185, 129, 0.4); }

    .bg-accent { background-color: var(--accent); }
    .text-accent { color: var(--accent); }
    .border-accent { border-color: var(--accent); }

    /* Keyframe Animations */
    @keyframes modalPop {
      0% { transform: scale(0.85) translateY(20px); opacity: 0; }
      100% { transform: scale(1) translateY(0); opacity: 1; }
    }
    
    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 15px var(--accent-glow); }
      50% { box-shadow: 0 0 30px var(--accent-glow); }
    }

    @keyframes floatEnvelope {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-6px) rotate(-1.5deg); }
    }

    /* Live Particle Background Floating Animation */
    @keyframes particleFloat {
      0% {
        transform: translateY(100%) scale(0.6) rotate(0deg);
        opacity: 0;
      }
      20% {
        opacity: 0.6;
      }
      80% {
        opacity: 0.6;
      }
      100% {
        transform: translateY(-120vh) scale(1.2) rotate(360deg);
        opacity: 0;
      }
    }

    .particle-item {
      position: absolute;
      pointer-events: none;
      animation: particleFloat linear infinite;
      user-select: none;
      z-index: 1;
    }

    .animate-pop { animation: modalPop 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .animate-glow { animation: pulseGlow 2.5s infinite ease-in-out; }
    .envelope-anim { animation: floatEnvelope 3s infinite ease-in-out; }

    .shake { animation: shake 0.4s cubic-bezier(.36,.07,.19,.97) both; }
    @keyframes shake {
      10%, 90% { transform: translate3d(-1px, 0, 0); }
      20%, 80% { transform: translate3d(2px, 0, 0); }
      30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
      40%, 60% { transform: translate3d(4px, 0, 0); }
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.15); border-radius: 10px; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-center items-center antialiased theme-love">

  <!-- ==================== 1. LOGIN MODAL ==================== -->
  <div id="login-modal" class="fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-2xl flex items-center justify-center p-4">
    <div id="login-card" class="bg-slate-900/90 border border-slate-800 p-8 rounded-3xl shadow-2xl max-w-sm w-full text-center space-y-6 animate-pop">
      <div class="w-16 h-16 bg-pink-500/10 text-pink-500 rounded-2xl flex items-center justify-center mx-auto text-2xl border border-pink-500/20 animate-glow">
        <i class="fa-solid fa-lock-keyhole"></i>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-white tracking-wide">Private Space</h2>
        <p class="text-xs text-slate-400 mt-1">প্রবেশের জন্য সিক্রেট পাসওয়ার্ড দিন</p>
      </div>

      <form onsubmit="handleLogin(event)" class="space-y-4">
        <input type="password" id="pass-input" placeholder="Enter Password..." required autocomplete="off"
          class="w-full px-4 py-3 bg-slate-800/80 border border-slate-700/60 rounded-xl text-center text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-pink-500 transition">
        
        <p id="error-msg" class="text-xs text-rose-500 font-medium hidden">পাসওয়ার্ড ভুল হয়েছে! আবার চেষ্টা করুন。</p>

        <button type="submit" 
          class="w-full py-3 bg-gradient-to-r from-pink-500 to-rose-600 hover:from-pink-600 hover:to-rose-700 text-white font-semibold rounded-xl shadow-lg transition duration-300 active:scale-95">
          Enter Space
        </button>
      </form>
    </div>
  </div>

  <!-- ==================== 2. MAIN APP SCREEN ==================== -->
  <div id="app-screen" class="hidden w-full max-w-md h-screen md:h-[92vh] md:rounded-3xl bg-slate-900 border-x md:border border-slate-800/80 flex flex-col overflow-hidden shadow-2xl relative">

    <!-- Global App Floating Background Particle Container -->
    <div id="global-particle-container" class="absolute inset-0 pointer-events-none overflow-hidden z-0"></div>

    <!-- ----------------- 2A. INBOX VIEW ----------------- -->
    <div id="inbox-view" class="flex-1 flex flex-col h-full bg-slate-950/80 relative overflow-hidden z-10">
      
      <!-- Top Title Bar -->
      <header class="p-5 bg-slate-900/90 border-b border-slate-800 flex justify-between items-center backdrop-blur-md sticky top-0 z-20">
        <div class="flex items-center gap-3">
          <div id="my-avatar" class="w-10 h-10 rounded-full bg-gradient-to-tr from-pink-500 to-purple-600 flex items-center justify-center font-bold text-white text-base overflow-hidden border border-pink-500/30">
            ?
          </div>
          <div>
            <h2 class="font-bold text-white text-base tracking-wide">Private Space</h2>
            <p id="user-my-role" class="text-[10px] text-pink-400 font-medium"></p>
          </div>
        </div>
        
        <div class="flex items-center gap-2">
          <button onclick="openSettings()" class="p-2.5 text-slate-400 hover:text-white bg-slate-800/80 rounded-xl transition hover:scale-105 active:scale-95">
            <i class="fa-solid fa-gear"></i>
          </button>
          <button onclick="logout()" class="p-2.5 text-slate-400 hover:text-rose-400 bg-slate-800/80 rounded-xl transition hover:scale-105 active:scale-95">
            <i class="fa-solid fa-right-from-bracket"></i>
          </button>
        </div>
      </header>

      <div class="p-4 space-y-5 overflow-y-auto flex-1 relative z-10">
        
        <!-- Partner Profile Card -->
        <div onclick="openChatView()" class="flex items-center p-4 rounded-2xl bg-slate-900/90 backdrop-blur-md border border-slate-800/80 hover:bg-slate-800/80 cursor-pointer transition-all duration-300 active:scale-98 shadow-xl">
          <div class="relative mr-4">
            <div id="inbox-partner-avatar" class="w-14 h-14 rounded-full bg-gradient-to-tr from-pink-500 to-purple-600 flex items-center justify-center font-bold text-white text-2xl shadow-lg border-2 border-slate-700 overflow-hidden">
              ?
            </div>
            <span class="w-4 h-4 bg-emerald-500 border-2 border-slate-900 rounded-full absolute bottom-0 right-0"></span>
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex justify-between items-baseline mb-1">
              <h3 id="inbox-partner-name" class="font-bold text-white truncate text-base">Partner ID</h3>
              <span id="inbox-last-time" class="text-[10px] text-slate-500">Active</span>
            </div>
            <p id="inbox-last-msg" class="text-xs text-slate-400 truncate">ক্লিক করে চ্যাটে প্রবেশ করুন...</p>
          </div>
        </div>

        <!-- Secret Envelope Box -->
        <div id="secret-envelope-container" class="hidden envelope-anim cursor-pointer p-4 rounded-2xl bg-slate-900/90 backdrop-blur-md border border-amber-500/40 hover:border-amber-500 transition-all duration-300 flex items-center space-x-4 relative shadow-2xl" onclick="openSecretLettersModal()">
          <div class="relative w-16 h-16 flex-shrink-0">
            <img src="https://images.unsplash.com/photo-1586075010923-2dd4570fb338?w=300&auto=format&fit=crop&q=80" 
                 alt="Paper Envelope" 
                 class="w-full h-full object-cover rounded-xl shadow-md border border-amber-200/20">
            <span id="secret-count-badge" class="absolute -top-2 -right-2 bg-pink-500 text-white font-bold text-[10px] w-5 h-5 rounded-full flex items-center justify-center border-2 border-slate-900 animate-pulse">1</span>
          </div>

          <div>
            <h4 class="font-bold text-amber-300 text-sm flex items-center gap-1.5">
              <i class="fa-solid fa-envelope"></i> একটি সিক্রেট চিঠি এসেছে!
            </h4>
            <p class="text-[11px] text-slate-400 mt-0.5">পড়ার জন্য এখানে ক্লিক করুন (একবার পড়লে গায়েব হয়ে যাবে)</p>
          </div>
        </div>

      </div>

      <!-- Floating Animated (+) Button & Action Drawer Menu -->
      <div class="absolute bottom-6 right-6 flex flex-col items-end z-30">
        
        <!-- Animated Secret Actions Menu -->
        <div id="fab-menu" class="hidden flex-col space-y-3 mb-3 transform transition-all duration-300 origin-bottom-right scale-90 opacity-0 items-end">
          
          <!-- TOP: Secret Message -->
          <button onclick="openSendSecretModal('text')" class="flex items-center justify-center space-x-3 bg-gradient-to-r from-pink-600 to-rose-600 border border-pink-400/50 text-white px-6 py-3.5 rounded-2xl shadow-2xl hover:scale-105 active:scale-95 transition-all duration-200 text-sm font-bold w-48">
            <i class="fa-solid fa-envelope text-lg"></i>
            <span>Secret Message</span>
          </button>

          <!-- BOTTOM: Secret Image -->
          <button onclick="openSendSecretModal('image')" class="flex items-center justify-center space-x-2 bg-slate-800/90 backdrop-blur-md border border-purple-500/40 text-purple-300 px-4 py-2.5 rounded-2xl shadow-xl hover:bg-slate-700 transition-all duration-200 active:scale-95 text-xs font-semibold w-40">
            <i class="fa-solid fa-image text-sm"></i>
            <span>Secret Image</span>
          </button>

        </div>

        <!-- Main FAB Toggle Button -->
        <button id="fab-btn" onclick="toggleFabMenu()" class="w-14 h-14 bg-accent text-white rounded-full flex items-center justify-center shadow-2xl text-2xl hover:scale-110 active:scale-90 transition-all duration-300 animate-glow">
          <i id="fab-icon" class="fa-solid fa-plus transition-transform duration-300"></i>
        </button>

      </div>

    </div>

    <!-- ----------------- 2B. CHAT ROOM VIEW ----------------- -->
    <div id="chat-view" class="hidden flex-1 flex-col h-full bg-slate-950 relative overflow-hidden z-10">
      
      <!-- Chat Background Particle Container -->
      <div id="chat-particle-container" class="absolute inset-0 pointer-events-none overflow-hidden z-0"></div>

      <!-- Chat Header -->
      <header class="px-4 py-3 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between backdrop-blur-md z-20">
        <div class="flex items-center space-x-3">
          <button onclick="closeChatView()" class="p-2 text-slate-400 hover:text-white rounded-lg transition active:scale-90">
            <i class="fa-solid fa-chevron-left text-lg"></i>
          </button>
          <div class="relative">
            <div id="chat-partner-avatar" class="w-10 h-10 rounded-full bg-gradient-to-tr from-pink-500 to-purple-600 flex items-center justify-center font-bold text-white text-base overflow-hidden border border-slate-700">
              ?
            </div>
            <span class="w-3 h-3 bg-emerald-500 border-2 border-slate-900 rounded-full absolute bottom-0 right-0"></span>
          </div>
          <div>
            <h3 id="chat-partner-name" class="font-bold text-white leading-tight text-sm">Partner</h3>
            <span class="text-[10px] text-emerald-400 font-medium">Active now</span>
          </div>
        </div>

        <button onclick="openSettings()" class="p-2 text-slate-400 hover:text-white transition active:scale-90">
          <i class="fa-solid fa-ellipsis-vertical text-lg"></i>
        </button>
      </header>

      <!-- Chat Messages Scroll Area -->
      <div id="chat-box" class="flex-1 overflow-y-auto p-4 space-y-3 relative z-10">
        <!-- Messages rendered dynamically -->
      </div>

      <!-- Quick Reply Preview Bar -->
      <div id="reply-preview-bar" class="hidden px-4 py-2 bg-slate-800/90 border-t border-slate-700/60 flex items-center justify-between text-xs backdrop-blur relative z-20">
        <div class="flex items-center gap-2 overflow-hidden">
          <i class="fa-solid fa-reply text-pink-400"></i>
          <div class="truncate">
            <span class="font-semibold text-pink-400" id="reply-user-label">Replying to</span>
            <p id="reply-text-label" class="text-slate-400 truncate"></p>
          </div>
        </div>
        <button onclick="cancelReply()" class="text-slate-400 hover:text-white px-2">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Input Footer -->
      <footer class="p-3 bg-slate-900/95 border-t border-slate-800 relative z-20 backdrop-blur-md">
        
        <!-- Categorized Emoji Drawer Modal -->
        <div id="emoji-picker" class="hidden absolute bottom-16 left-3 bg-slate-800/95 border border-slate-700 rounded-2xl p-3 shadow-2xl w-80 z-30 animate-pop backdrop-blur-lg">
          <div class="flex justify-between items-center mb-2 pb-1 border-b border-slate-700 text-xs text-slate-400">
            <span class="font-semibold text-pink-400">Expressive Emojis</span>
            <button onclick="toggleEmojiPicker()" class="hover:text-white"><i class="fa-solid fa-xmark"></i></button>
          </div>
          
          <div class="grid grid-cols-6 gap-2 text-2xl max-h-52 overflow-y-auto p-1">
            <button onclick="addEmoji('👍')" class="hover:scale-125 transition">👍</button>
            <button onclick="addEmoji('❤️')" class="hover:scale-125 transition">❤️</button>
            <button onclick="addEmoji('💖')" class="hover:scale-125 transition">💖</button>
            <button onclick="addEmoji('💕')" class="hover:scale-125 transition">💕</button>
            <button onclick="addEmoji('🥰')" class="hover:scale-125 transition">🥰</button>
            <button onclick="addEmoji('🥺')" class="hover:scale-125 transition">🥺</button>
            <button onclick="addEmoji('🙈')" class="hover:scale-125 transition">🙈</button>
            <button onclick="addEmoji('🤗')" class="hover:scale-125 transition">🤗</button>
            <button onclick="addEmoji('💋')" class="hover:scale-125 transition">💋</button>
            <button onclick="addEmoji('😘')" class="hover:scale-125 transition">😘</button>
            <button onclick="addEmoji('😍')" class="hover:scale-125 transition">😍</button>
            <button onclick="addEmoji('🌹')" class="hover:scale-125 transition">🌹</button>
            <button onclick="addEmoji('🔥')" class="hover:scale-125 transition">🔥</button>
            <button onclick="addEmoji('💌')" class="hover:scale-125 transition">💌</button>
            <button onclick="addEmoji('🧸')" class="hover:scale-125 transition">🧸</button>
            <button onclick="addEmoji('💍')" class="hover:scale-125 transition">💍</button>
            <button onclick="addEmoji('✨')" class="hover:scale-125 transition">✨</button>
            <button onclick="addEmoji('🤍')" class="hover:scale-125 transition">🤍</button>
          </div>
        </div>

        <form onsubmit="sendMessage(event)" class="flex items-center space-x-2">
          <button type="button" onclick="toggleEmojiPicker()" class="p-2.5 text-slate-400 hover:text-pink-400 hover:bg-slate-800 rounded-xl transition">
            <i class="fa-regular fa-face-smile text-xl"></i>
          </button>

          <input type="text" id="message-input" placeholder="Type a message..." autocomplete="off"
            class="flex-1 bg-slate-800/90 text-slate-100 placeholder-slate-500 px-4 py-2.5 rounded-xl border border-slate-700/60 focus:outline-none focus:border-pink-500 text-sm transition">

          <button type="submit" class="p-2.5 bg-accent hover:opacity-90 rounded-xl text-white transition shadow-md active:scale-90">
            <i class="fa-solid fa-paper-plane"></i>
          </button>
        </form>
      </footer>
    </div>
  </div>

  <!-- ==================== 3. SEND SECRET MESSAGE / IMAGE MODAL ==================== -->
  <div id="send-secret-modal" class="hidden fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-xl flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl max-w-sm w-full p-6 space-y-4 shadow-2xl relative animate-pop">
      <div class="flex justify-between items-center border-b border-slate-800 pb-3">
        <h3 id="send-secret-title" class="font-bold text-white text-sm flex items-center gap-2 text-pink-400">
          <!-- Dynamic Title -->
        </h3>
        <button onclick="closeSendSecretModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-base"></i></button>
      </div>

      <div class="space-y-3">
        <div id="secret-input-container">
          <!-- Dynamic Input Text or Image Upload / Camera Options -->
        </div>
      </div>

      <button onclick="submitSecretContent()" class="w-full py-3 bg-accent hover:opacity-90 font-semibold text-white text-xs rounded-xl transition shadow-lg active:scale-95">
        Send Secret
      </button>
    </div>
  </div>

  <!-- ==================== 4. REAL PAPER SECRET LETTER / IMAGE READ MODAL ==================== -->
  <div id="secret-letter-modal" class="hidden fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-xl flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-amber-500/40 rounded-3xl max-w-sm w-full p-6 shadow-2xl space-y-4 relative overflow-hidden animate-pop">
      
      <div class="flex justify-between items-center border-b border-slate-800 pb-2">
        <span class="text-xs font-semibold text-amber-400 flex items-center gap-1.5">
          <i class="fa-solid fa-envelope-open-text"></i> Secret Envelope Content
        </span>
        <button onclick="closeSecretLettersModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <!-- Paper Envelope Content List -->
      <div id="secret-letters-list" class="space-y-4 max-h-80 overflow-y-auto">
        <!-- Dynamic Secret Text or Image Render Here -->
      </div>

      <p class="text-[10px] text-slate-500 text-center italic">বন্ধ করার সাথে সাথে চিঠিটি চিরতরে মুছে যাবে</p>

      <button onclick="closeSecretLettersModal()" class="w-full py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-semibold text-xs rounded-xl transition active:scale-95">
        Read & Close
      </button>
    </div>
  </div>

  <!-- ==================== 5. CONTEXT MENU & REACTION POPUP ==================== -->
  <div id="context-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4" onclick="closeContextMenu()">
    <div class="bg-slate-900 border border-slate-700/80 rounded-2xl p-3 shadow-2xl max-w-xs w-full space-y-3 animate-pop" onclick="event.stopPropagation()">
      
      <div class="flex items-center justify-around bg-slate-800/90 p-2 rounded-xl text-2xl border border-slate-700/50">
        <button onclick="addReaction('👍')" class="hover:scale-130 transition">👍</button>
        <button onclick="addReaction('❤️')" class="hover:scale-130 transition">❤️</button>
        <button onclick="addReaction('🥰')" class="hover:scale-130 transition">🥰</button>
        <button onclick="addReaction('🤗')" class="hover:scale-130 transition">🤗</button>
        <button onclick="addReaction('💋')" class="hover:scale-130 transition">💋</button>
        <button onclick="toggleFullReactionPicker()" class="w-8 h-8 rounded-full bg-slate-700 hover:bg-pink-500 text-white flex items-center justify-center font-bold text-base transition">
          +
        </button>
      </div>

      <div id="full-reaction-picker" class="hidden grid grid-cols-6 gap-2 text-2xl max-h-36 overflow-y-auto bg-slate-800 p-2 rounded-xl border border-slate-700">
        <button onclick="addReaction('💖')" class="hover:scale-125 transition">💖</button>
        <button onclick="addReaction('💕')" class="hover:scale-125 transition">💕</button>
        <button onclick="addReaction('🥺')" class="hover:scale-125 transition">🥺</button>
        <button onclick="addReaction('🙈')" class="hover:scale-125 transition">🙈</button>
        <button onclick="addReaction('😘')" class="hover:scale-125 transition">😘</button>
        <button onclick="addReaction('😍')" class="hover:scale-125 transition">😍</button>
        <button onclick="addReaction('🌹')" class="hover:scale-125 transition">🌹</button>
        <button onclick="addReaction('🔥')" class="hover:scale-125 transition">🔥</button>
        <button onclick="addReaction('💌')" class="hover:scale-125 transition">💌</button>
        <button onclick="addReaction('🧸')" class="hover:scale-125 transition">🧸</button>
        <button onclick="addReaction('💍')" class="hover:scale-125 transition">💍</button>
        <button onclick="addReaction('✨')" class="hover:scale-125 transition">✨</button>
      </div>

      <div class="space-y-1 text-sm">
        <button onclick="actionReply()" class="w-full text-left px-3 py-2 text-slate-200 hover:bg-slate-800 rounded-lg flex items-center gap-3">
          <i class="fa-solid fa-reply text-pink-400"></i> Quick Reply
        </button>
        <button onclick="actionToggleBold()" class="w-full text-left px-3 py-2 text-slate-200 hover:bg-slate-800 rounded-lg flex items-center gap-3">
          <i class="fa-solid fa-bold text-amber-400"></i> Bold & Highlight
        </button>
        <button id="action-edit-btn" onclick="actionEdit()" class="w-full text-left px-3 py-2 text-slate-200 hover:bg-slate-800 rounded-lg flex items-center gap-3">
          <i class="fa-solid fa-pen-to-square text-emerald-400"></i> Edit Message
        </button>
        <button onclick="actionDelete()" class="w-full text-left px-3 py-2 text-rose-400 hover:bg-rose-500/10 rounded-lg flex items-center gap-3">
          <i class="fa-solid fa-trash-can"></i> Delete Message
        </button>
      </div>
    </div>
  </div>

  <!-- ==================== 6. SETTINGS MODAL ==================== -->
  <div id="settings-modal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-xl flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl max-w-sm w-full p-6 space-y-5 shadow-2xl animate-pop">
      <div class="flex justify-between items-center border-b border-slate-800 pb-3">
        <h3 class="font-bold text-white text-base flex items-center gap-2"><i class="fa-solid fa-sliders text-pink-500"></i> Settings</h3>
