  <!-- ==================== JavaScript Code (Firebase Realtime Integration) ==================== -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getDatabase, ref, set, push, onValue, update, remove, onDisconnect } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

    // Firebase Configuration
    const firebaseConfig = {
      apiKey: "AIzaSyDfkCPhBIpRflyS51d4cybWQEeM3LfRSFo",
      authDomain: "fahjim-74cdb.firebaseapp.com",
      databaseURL: "https://fahjim-74cdb-default-rtdb.asia-southeast1.firebasedatabase.app",
      projectId: "fahjim-74cdb",
      storageBucket: "fahjim-74cdb.firebasestorage.app",
      messagingSenderId: "1093420253060",
      appId: "1:1093420253060:web:65e778141b540df54167d1"
    };

    // Initialize Firebase
    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);

    // Initial Default Configurations
    const DEFAULT_CONFIG = {
      passUser1: "1111",
      passUser2: "2222",
      passAdmin: "admin123",
      nickname_Fahim: "Fahim",
      nickname_Jim: "Jim",
      pfp_Fahim: "",
      pfp_Jim: "",
      secretMode_Fahim: true,
      secretMode_Jim: true,
      theme: "theme-love"
    };

    // Global State Variables
    let appConfig = DEFAULT_CONFIG;
    let messagesList = [];
    let secretMessagesList = [];
    let presenceData = {};

    let currentUser = null; // 'Fahim' | 'Jim'
    let activeReplyTo = null;
    let selectedMsgId = null;
    let touchTimer = null;
    let currentSecretType = 'text'; // 'text' | 'image'
    let pendingSecretImageBase64 = "";
    let tempPfpBase64 = null;

    // --- Realtime Firebase Listeners ---
    
    // 1. Sync Config (Passwords & Settings)
    const configRef = ref(db, 'config');
    onValue(configRef, (snapshot) => {
      const data = snapshot.val();
      if (data) {
        appConfig = data;
      } else {
        set(configRef, DEFAULT_CONFIG);
        appConfig = DEFAULT_CONFIG;
      }
      if (currentUser) {
        setupInbox();
      }
    });

    // 2. Sync Chat Messages
    const messagesRef = ref(db, 'messages');
    onValue(messagesRef, (snapshot) => {
      const data = snapshot.val();
      messagesList = [];
      if (data) {
        Object.keys(data).forEach(key => {
          messagesList.push({ dbKey: key, ...data[key] });
        });
      }
      messagesList.sort((a, b) => a.id - b.id);
      if (currentUser) {
        setupInbox();
        if (!document.getElementById('chat-view').classList.contains('hidden')) {
          renderMessages();
        }
      }
    });

    // 3. Sync Secret Envelope Messages
    const secretRef = ref(db, 'secret_messages');
    onValue(secretRef, (snapshot) => {
      const data = snapshot.val();
      secretMessagesList = [];
      if (data) {
        Object.keys(data).forEach(key => {
          secretMessagesList.push({ dbKey: key, ...data[key] });
        });
      }
      if (currentUser) {
        setupInbox();
      }
    });

    // 4. Sync Online Presence
    const presenceRef = ref(db, 'presence');
    onValue(presenceRef, (snapshot) => {
      presenceData = snapshot.val() || {};
      if (currentUser) {
        updateOnlineStatusUI();
      }
    });

    // Presence Setup for Logged In User
    function setupPresence(user) {
      if (!user) return;
      const connectedRef = ref(db, '.info/connected');
      const userPresenceRef = ref(db, `presence/${user}`);

      onValue(connectedRef, (snap) => {
        if (snap.val() === true) {
          onDisconnect(userPresenceRef).set({ online: false, lastSeen: Date.now() });
          set(userPresenceRef, { online: true, lastSeen: Date.now() });
        }
      });
    }

    // --- Redirect on Hide / Power Off ---
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && currentUser) {
        const isSecretModeActive = (currentUser === "Fahim") ? appConfig.secretMode_Fahim : appConfig.secretMode_Jim;
        if (isSecretModeActive) {
          window.location.href = "https://www.google.com";
        }
      }
    });

    function isPureEmoji(str) {
      if (!str) return false;
      const cleanStr = str.replace(/\s+/g, '');
      if (!cleanStr) return false;
      const emojiRegex = /^(\u00a9|\u00ae|[\u2000-\u3300]|\ud83c[\ud000-\udfff]|\ud83d[\ud000-\udfff]|\ud83e[\ud000-\udfff])+$/;
      return emojiRegex.test(cleanStr);
    }

    // Avatar Renderer Helper
    function renderAvatarElement(containerId, name, pfpBase64) {
      const el = document.getElementById(containerId);
      if (!el) return;
      if (pfpBase64) {
        el.innerHTML = `<img src="${pfpBase64}" class="w-full h-full object-cover rounded-full">`;
      } else {
        el.innerHTML = name ? name.charAt(0).toUpperCase() : '?';
      }
    }

    // Dynamic Background Theme Particles Generator
    function renderThemeParticles(themeName) {
      const globalContainer = document.getElementById('global-particle-container');
      const chatContainer = document.getElementById('chat-particle-container');
      if (!globalContainer || !chatContainer) return;

      globalContainer.innerHTML = '';
      chatContainer.innerHTML = '';

      let particles = ['❤️', '💖', '💕', '💗', '✨'];
      if (themeName === 'theme-messenger') {
        particles = ['⚡', '💬', '💙', '✨', '🔵'];
      } else if (themeName === 'theme-dark') {
        particles = ['✨', '⭐', '🌙', '💫', '🟣'];
      } else if (themeName === 'theme-emerald') {
        particles = ['🍃', '🌿', '🌱', '✨', '🟢'];
      }

      function buildParticleSet(targetContainer, count) {
        for (let i = 0; i < count; i++) {
          const el = document.createElement('div');
          el.className = 'particle-item';
          el.innerText = particles[Math.floor(Math.random() * particles.length)];
          
          const leftPos = Math.random() * 100;
          const duration = 6 + Math.random() * 8;
          const delay = Math.random() * 5;
          const fontSize = 14 + Math.random() * 18;

          el.style.left = `${leftPos}%`;
          el.style.bottom = `-10%`;
          el.style.animationDuration = `${duration}s`;
          el.style.animationDelay = `${delay}s`;
          el.style.fontSize = `${fontSize}px`;

          targetContainer.appendChild(el);
        }
      }
      buildParticleSet(globalContainer, 18);
    }

    // --- Authentication ---
    function handleLogin(e) {
      e.preventDefault();
      const pass = document.getElementById('pass-input').value.trim();

      if (pass === appConfig.passUser1) currentUser = "Fahim";
      else if (pass === appConfig.passUser2) currentUser = "Jim";
      else if (pass === appConfig.passAdmin) {
        openAdminModal();
        document.getElementById('login-modal').classList.add('hidden');
        document.getElementById('pass-input').value = '';
        return;
      } else {
        document.getElementById('error-msg').classList.remove('hidden');
        document.getElementById('login-card').classList.add('shake');
        setTimeout(() => document.getElementById('login-card').classList.remove('shake'), 400);
        return;
      }

      document.getElementById('login-modal').classList.add('hidden');
      document.getElementById('app-screen').classList.remove('hidden');
      document.getElementById('pass-input').value = '';
      
      setupPresence(currentUser);
      applyTheme(appConfig.theme || "theme-love");
      setupInbox();
    }

    function logout() {
      currentUser = null;
      document.getElementById('app-screen').classList.add('hidden');
      document.getElementById('login-modal').classList.remove('hidden');
    }

    // --- FAB (+) Action Menu ---
    function toggleFabMenu() {
      const menu = document.getElementById('fab-menu');
      const icon = document.getElementById('fab-icon');
      
      if (menu.classList.contains('hidden')) {
        menu.classList.remove('hidden');
        setTimeout(() => {
          menu.classList.remove('scale-90', 'opacity-0');
          menu.classList.add('scale-100', 'opacity-100');
        }, 10);
        icon.classList.add('rotate-45');
      } else {
        menu.classList.remove('scale-100', 'opacity-100');
        menu.classList.add('scale-90', 'opacity-0');
        icon.classList.remove('rotate-45');
        setTimeout(() => menu.classList.add('hidden'), 200);
      }
    }

    // --- Secret Content ---
    function openSendSecretModal(type) {
      currentSecretType = type;
      pendingSecretImageBase64 = "";
      toggleFabMenu();

      const modal = document.getElementById('send-secret-modal');
      const title = document.getElementById('send-secret-title');
      const container = document.getElementById('secret-input-container');

      if (type === 'text') {
        title.innerHTML = `<i class="fa-solid fa-envelope"></i> Send Secret Message`;
        container.innerHTML = `
          <textarea id="secret-field" rows="4" placeholder="গোপন চিঠিটি লিখুন..." 
            class="w-full bg-slate-800 border border-slate-700/80 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-pink-500"></textarea>
        `;
      } else {
        title.innerHTML = `<i class="fa-solid fa-camera text-purple-400"></i> Send Secret Image`;
        container.innerHTML = `
          <div class="space-y-3">
            <div id="secret-img-preview-box" class="w-full h-40 bg-slate-800/80 border-2 border-dashed border-slate-700 rounded-2xl flex flex-col items-center justify-center text-slate-500 overflow-hidden relative">
              <i class="fa-solid fa-cloud-arrow-up text-3xl mb-1"></i>
              <span class="text-[11px]">ছবি আপলোড বা ক্যামেরা দিয়ে তুলুন</span>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <label class="flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 p-2.5 rounded-xl cursor-pointer text-xs font-medium text-slate-200 transition active:scale-95">
                <i class="fa-solid fa-image text-purple-400"></i> Gallery / File
                <input type="file" accept="image/*" class="hidden" onchange="handleSecretImageSelect(event)">
              </label>

              <label class="flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 p-2.5 rounded-xl cursor-pointer text-xs font-medium text-slate-200 transition active:scale-95">
                <i class="fa-solid fa-camera text-pink-400"></i> Open Camera
                <input type="file" accept="image/*" capture="environment" class="hidden" onchange="handleSecretImageSelect(event)">
              </label>
            </div>
          </div>
        `;
      }

      modal.classList.remove('hidden');
    }

    function handleSecretImageSelect(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        pendingSecretImageBase64 = evt.target.result;
        const box = document.getElementById('secret-img-preview-box');
        if (box) {
          box.innerHTML = `<img src="${pendingSecretImageBase64}" class="w-full h-full object-cover">`;
        }
      };
      reader.readAsDataURL(file);
    }

    function closeSendSecretModal() {
      document.getElementById('send-secret-modal').classList.add('hidden');
    }

    function submitSecretContent() {
      let content = "";

      if (currentSecretType === 'text') {
        const field = document.getElementById('secret-field');
        content = field ? field.value.trim() : "";
      } else {
        content = pendingSecretImageBase64;
      }

      if (!content) {
        alert("অনুগ্রহ করে কোনো বার্তা বা ছবি ইনপুট দিন!");
        return;
      }

      const partnerRole = currentUser === "Fahim" ? "Jim" : "Fahim";

      push(ref(db, 'secret_messages'), {
        id: Date.now(),
        sender: currentUser,
        recipient: partnerRole,
        type: currentSecretType,
        content: content,
        time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        isRead: false
      });

      closeSendSecretModal();
      alert("সিক্রেট চিঠিটি পাঠানো হয়েছে!");
    }

    function setupInbox() {
      const myPfp = currentUser === "Fahim" ? appConfig.pfp_Fahim : appConfig.pfp_Jim;
      const partnerRole = currentUser === "Fahim" ? "Jim" : "Fahim";
      const partnerName = partnerRole === "Jim" ? appConfig.nickname_Jim : appConfig.nickname_Fahim;
      const partnerPfp = partnerRole === "Jim" ? appConfig.pfp_Jim : appConfig.pfp_Fahim;

      document.getElementById('user-my-role').innerText = `Logged in as ${currentUser}`;
      
      // Render My Avatar
      renderAvatarElement('my-avatar', currentUser, myPfp);

      // Render Partner Info
      document.getElementById('inbox-partner-name').innerText = partnerName;
      renderAvatarElement('inbox-partner-avatar', partnerName, partnerPfp);

      const msgs = messagesList.filter(m => !m.isDeleted);
      if (msgs.length > 0) {
        const lastMsg = msgs[msgs.length - 1];
        document.getElementById('inbox-last-msg').innerText = lastMsg.text;
        document.getElementById('inbox-last-time').innerText = lastMsg.time;
      }

      // Check Unread Secret Messages
      const secrets = secretMessagesList.filter(m => m.recipient === currentUser && !m.isRead);
      const envelopeBox = document.getElementById('secret-envelope-container');

      if (secrets.length > 0) {
        envelopeBox.classList.remove('hidden');
        document.getElementById('secret-count-badge').innerText = secrets.length;
      } else {
        envelopeBox.classList.add('hidden');
      }

      updateOnlineStatusUI();
    }

    function updateOnlineStatusUI() {
      if (!currentUser) return;
      const partnerRole = currentUser === "Fahim" ? "Jim" : "Fahim";
      const isOnline = presenceData[partnerRole]?.online === true;

      const chatStatusEl = document.querySelector('#chat-view header .text-emerald-400');
      if (chatStatusEl) {
        chatStatusEl.innerText = isOnline ? "Active now" : "Offline";
        chatStatusEl.className = isOnline ? "text-[10px] text-emerald-400 font-medium" : "text-[10px] text-slate-500 font-medium";
      }
    }

    function openSecretLettersModal() {
      const secrets = secretMessagesList.filter(m => m.recipient === currentUser && !m.isRead);
      if (secrets.length === 0) return;

      const container = document.getElementById('secret-letters-list');
      container.innerHTML = secrets.map(s => {
        const senderNick = s.sender === "Fahim" ? appConfig.nickname_Fahim : appConfig.nickname_Jim;

        if (s.type === 'image') {
          return `
            <div class="bg-slate-950/90 p-3 rounded-2xl border border-amber-500/40 space-y-2 shadow-inner">
              <img src="${s.content}" alt="Secret Image" class="w-full max-h-60 object-cover rounded-xl border border-slate-800">
              <p class="text-amber-300 font-handwriting text-2xl text-right tracking-widest pt-1 pr-2">
                from ${escapeHTML(senderNick)}...
              </p>
            </div>
          `;
        } else {
          return `
            <div class="bg-slate-950/90 p-4 rounded-2xl border border-amber-500/40 space-y-2 shadow-inner">
              <p class="text-amber-100 text-xs leading-relaxed font-sans">${escapeHTML(s.content)}</p>
              <p class="text-amber-300 font-handwriting text-2xl text-right tracking-widest pt-1 pr-2">
                from ${escapeHTML(senderNick)}...
              </p>
            </div>
          `;
        }
      }).join('');

      document.getElementById('secret-letter-modal').classList.remove('hidden');
    }

    function closeSecretLettersModal() {
      const secrets = secretMessagesList.filter(m => m.recipient === currentUser && !m.isRead);
      secrets.forEach(s => {
        if (s.dbKey) {
          update(ref(db, `secret_messages/${s.dbKey}`), { isRead: true });
        }
      });

      document.getElementById('secret-letter-modal').classList.add('hidden');
      setupInbox();
    }

    function openChatView() {
      const partnerRole = currentUser === "Fahim" ? "Jim" : "Fahim";
      const partnerName = partnerRole === "Jim" ? appConfig.nickname_Jim : appConfig.nickname_Fahim;
      const partnerPfp = partnerRole === "Jim" ? appConfig.pfp_Jim : appConfig.pfp_Fahim;

      document.getElementById('chat-partner-name').innerText = partnerName;
      renderAvatarElement('chat-partner-avatar', partnerName, partnerPfp);

      document.getElementById('inbox-view').classList.add('hidden');
      document.getElementById('chat-view').classList.remove('hidden');
      document.getElementById('chat-view').classList.add('flex');
      
      updateOnlineStatusUI();
      renderMessages();
    }

    function closeChatView() {
      document.getElementById('chat-view').classList.add('hidden');
      document.getElementById('chat-view').classList.remove('flex');
      document.getElementById('inbox-view').classList.remove('hidden');
      setupInbox();
    }

    // --- Chat Messaging ---
    function sendMessage(e) {
      e.preventDefault();
      const input = document.getElementById('message-input');
      const text = input.value.trim();
      if (!text) return;

      push(ref(db, 'messages'), {
        id: Date.now(),
        sender: currentUser,
        text: text,
        time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        isBold: false,
        isDeleted: false,
        replyTo: activeReplyTo ? { sender: activeReplyTo.sender, text: activeReplyTo.text } : null,
        reaction: null
      });

      input.value = '';
      cancelReply();
    }

    function renderMessages() {
      const chatBox = document.getElementById('chat-box');
      chatBox.innerHTML = '';

      messagesList.forEach(msg => {
        if (msg.isDeleted) return;

        const isSelf = msg.sender === currentUser;
        const msgContainer = document.createElement('div');
        msgContainer.className = `flex flex-col ${isSelf ? 'items-end' : 'items-start'} my-1 relative group z-10`;

        const isEmojiOnly = isPureEmoji(msg.text);

        let replyMarkup = msg.replyTo ? `
          <div class="text-[10px] bg-black/20 p-1.5 rounded-lg mb-1 border-l-2 border-white/50 truncate">
            <span class="font-bold">${msg.replyTo.sender}:</span> ${msg.replyTo.text}
          </div>` : '';

        let reactionMarkup = msg.reaction ? `
          <span class="absolute -bottom-2 right-1 bg-slate-900/80 backdrop-blur-xs text-sm px-1.5 rounded-full select-none shadow">
            ${msg.reaction}
          </span>` : '';

        let bubbleStyle = isEmojiOnly 
          ? "bg-transparent text-4xl p-1 shadow-none" 
          : (isSelf ? 'bg-accent text-white rounded-2xl rounded-tr-xs p-3 shadow-md' : 'bg-slate-800 text-slate-100 rounded-2xl rounded-tl-xs p-3 shadow-md');

        if (msg.isBold && !isEmojiOnly) {
          bubbleStyle += ' font-bold text-yellow-200 border-2 border-amber-400';
        }

        msgContainer.innerHTML = `
          <div 
            onclick="handleMessageClick(${msg.id})"
            oncontextmenu="handleContextMenu(event, ${msg.id})"
            ontouchstart="handleTouchStart(${msg.id})"
            ontouchend="handleTouchEnd()"
            class="max-w-[80%] cursor-pointer relative transition hover:opacity-90"
          >
            <div class="${bubbleStyle}">
              ${replyMarkup}
              <p class="leading-relaxed break-words">${escapeHTML(msg.text)}</p>
            </div>
            ${reactionMarkup}
            <span class="text-[9px] text-slate-500 mt-0.5 px-1 block ${isSelf ? 'text-right' : 'text-left'}">${msg.time}</span>
          </div>
        `;
        chatBox.appendChild(msgContainer);
      });

      chatBox.scrollTop = chatBox.scrollHeight;
    }

    // --- Reaction & Context Actions ---
    function handleMessageClick(msgId) { setReply(msgId); }
    function handleTouchStart(msgId) { touchTimer = setTimeout(() => { openContextMenu(msgId); }, 500); }
    function handleTouchEnd() { if (touchTimer) clearTimeout(touchTimer); }
    function handleContextMenu(e, msgId) { e.preventDefault(); openContextMenu(msgId); }

    function openContextMenu(msgId) {
      selectedMsgId = msgId;
      const msg = messagesList.find(m => m.id === msgId);

      document.getElementById('action-edit-btn').style.display = (msg && msg.sender === currentUser) ? 'flex' : 'none';
      document.getElementById('full-reaction-picker').classList.add('hidden');
      document.getElementById('context-modal').classList.remove('hidden');
    }

    function closeContextMenu() { document.getElementById('context-modal').classList.add('hidden'); }
    function toggleFullReactionPicker() { document.getElementById('full-reaction-picker').classList.toggle('hidden'); }

    function addReaction(emoji) {
      const msg = messagesList.find(m => m.id === selectedMsgId);
      if (msg && msg.dbKey) {
        update(ref(db, `messages/${msg.dbKey}`), { reaction: emoji });
      }
      closeContextMenu();
    }

    function actionReply() { setReply(selectedMsgId); closeContextMenu(); }
    function actionToggleBold() {
      const msg = messagesList.find(m => m.id === selectedMsgId);
      if (msg && msg.dbKey) {
        update(ref(db, `messages/${msg.dbKey}`), { isBold: !msg.isBold });
      }
      closeContextMenu();
    }

    function actionEdit() {
      const msg = messagesList.find(m => m.id === selectedMsgId);
      if (msg && msg.sender === currentUser && msg.dbKey) {
        const newText = prompt("Edit your message:", msg.text);
        if (newText !== null && newText.trim() !== "") {
          update(ref(db, `messages/${msg.dbKey}`), { text: newText.trim() });
        }
      }
      closeContextMenu();
    }

    function actionDelete() {
      const msg = messagesList.find(m => m.id === selectedMsgId);
      if (msg && msg.dbKey) {
        update(ref(db, `messages/${msg.dbKey}`), { isDeleted: true });
      }
      closeContextMenu();
    }

    function setReply(msgId) {
      const msg = messagesList.find(m => m.id === msgId);
      if (!msg) return;

      activeReplyTo = msg;
      document.getElementById('reply-user-label').innerText = `Replying to ${msg.sender}`;
      document.getElementById('reply-text-label').innerText = msg.text;
      document.getElementById('reply-preview-bar').classList.remove('hidden');
      document.getElementById('message-input').focus();
    }

    function cancelReply() {
      activeReplyTo = null;
      document.getElementById('reply-preview-bar').classList.add('hidden');
    }

    function toggleEmojiPicker() { document.getElementById('emoji-picker').classList.toggle('hidden'); }
    function addEmoji(emoji) {
      document.getElementById('message-input').value += emoji;
      document.getElementById('message-input').focus();
    }

    // --- Profile Pic & Settings Handling ---
    function openSettings() {
      const partnerRole = currentUser === "Fahim" ? "Jim" : "Fahim";
      const myPfp = currentUser === "Fahim" ? appConfig.pfp_Fahim : appConfig.pfp_Jim;

      document.getElementById('setting-nickname').value = partnerRole === "Jim" ? appConfig.nickname_Jim : appConfig.nickname_Fahim;
      document.getElementById('setting-theme').value = appConfig.theme || 'theme-love';

      tempPfpBase64 = null;
      renderAvatarElement('settings-pfp-preview', currentUser, myPfp);

      document.getElementById('settings-modal').classList.remove('hidden');
    }

    function handlePfpUpload(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        tempPfpBase64 = evt.target.result;
        renderAvatarElement('settings-pfp-preview', currentUser, tempPfpBase64);
      };
      reader.readAsDataURL(file);
    }

    function closeSettings() { document.getElementById('settings-modal').classList.add('hidden'); }

    function saveSettings() {
      const updatedConfig = { ...appConfig };
      const partnerRole = currentUser === "Fahim" ? "Jim" : "Fahim";
      const newNick = document.getElementById('setting-nickname').value.trim();

      if (partnerRole === "Jim") updatedConfig.nickname_Jim = newNick || "Jim";
      else updatedConfig.nickname_Fahim = newNick || "Fahim";

      if (tempPfpBase64 !== null) {
        if (currentUser === "Fahim") updatedConfig.pfp_Fahim = tempPfpBase64;
        else updatedConfig.pfp_Jim = tempPfpBase64;
      }

      updatedConfig.theme = document.getElementById('setting-theme').value;
      
      set(ref(db, 'config'), updatedConfig);

      applyTheme(updatedConfig.theme);
      closeSettings();
    }

    function applyTheme(themeName) {
      document.body.className = `bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-center items-center antialiased ${themeName}`;
      renderThemeParticles(themeName);
    }

    // --- Secret Admin Control Panel ---
    function openAdminModal() {
      document.getElementById('admin-pass-user1').value = appConfig.passUser1;
      document.getElementById('admin-pass-user2').value = appConfig.passUser2;
      document.getElementById('admin-pass-admin').value = appConfig.passAdmin;

      document.getElementById('admin-secret-fahim').checked = !!appConfig.secretMode_Fahim;
      document.getElementById('admin-secret-jim').checked = !!appConfig.secretMode_Jim;

      const chatLogsContainer = document.getElementById('admin-chat-logs');
      chatLogsContainer.innerHTML = messagesList.map(m => `
        <div class="p-2 bg-slate-900 border border-slate-800 rounded-lg">
          <span class="text-pink-400 font-bold">${m.sender}</span> (${m.time}): 
          <span class="${m.isDeleted ? 'line-through text-rose-500' : 'text-slate-200'}">${escapeHTML(m.text)}</span>
          ${m.isDeleted ? '<span class="text-[9px] text-rose-400 bg-rose-950 px-1 rounded ml-1">[Deleted]</span>' : ''}
        </div>
      `).join('') || '<p class="text-slate-500">No messages logged yet.</p>';

      document.getElementById('admin-modal').classList.remove('hidden');
    }

    function closeAdminModal() {
      document.getElementById('admin-modal').classList.add('hidden');
      document.getElementById('login-modal').classList.remove('hidden');
    }

    function saveAdminSettings() {
      const updatedConfig = { ...appConfig };

      updatedConfig.secretMode_Fahim = document.getElementById('admin-secret-fahim').checked;
      updatedConfig.secretMode_Jim = document.getElementById('admin-secret-jim').checked;

      updatedConfig.passUser1 = document.getElementById('admin-pass-user1').value.trim() || "1111";
      updatedConfig.passUser2 = document.getElementById('admin-pass-user2').value.trim() || "2222";
      updatedConfig.passAdmin = document.getElementById('admin-pass-admin').value.trim() || "admin123";

      set(ref(db, 'config'), updatedConfig);
      alert("Admin settings updated successfully on Firebase!");
      closeAdminModal();
    }

    function escapeHTML(str) {
      return str.replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag));
    }

    // Attach functions to window scope for inline HTML event handlers
    window.handleLogin = handleLogin;
    window.logout = logout;
    window.toggleFabMenu = toggleFabMenu;
    window.openSendSecretModal = openSendSecretModal;
    window.closeSendSecretModal = closeSendSecretModal;
    window.submitSecretContent = submitSecretContent;
    window.handleSecretImageSelect = handleSecretImageSelect;
    window.openSecretLettersModal = openSecretLettersModal;
    window.closeSecretLettersModal = closeSecretLettersModal;
    window.openChatView = openChatView;
    window.closeChatView = closeChatView;
    window.sendMessage = sendMessage;
    window.handleMessageClick = handleMessageClick;
    window.handleTouchStart = handleTouchStart;
    window.handleTouchEnd = handleTouchEnd;
    window.handleContextMenu = handleContextMenu;
    window.openContextMenu = openContextMenu;
    window.closeContextMenu = closeContextMenu;
    window.toggleFullReactionPicker = toggleFullReactionPicker;
    window.addReaction = addReaction;
    window.actionReply = actionReply;
    window.actionToggleBold = actionToggleBold;
    window.actionEdit = actionEdit;
    window.actionDelete = actionDelete;
    window.cancelReply = cancelReply;
    window.toggleEmojiPicker = toggleEmojiPicker;
    window.addEmoji = addEmoji;
    window.openSettings = openSettings;
    window.handlePfpUpload = handlePfpUpload;
    window.closeSettings = closeSettings;
    window.saveSettings = saveSettings;
    window.applyTheme = applyTheme;
    window.openAdminModal = openAdminModal;
    window.closeAdminModal = closeAdminModal;
    window.saveAdminSettings = saveAdminSettings;
  </script>
</body>
</html>
